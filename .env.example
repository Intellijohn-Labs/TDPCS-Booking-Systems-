# TDPCS-Apt Environment Variables
# Vercel Deployment & Local Development

# Database switch: true for local sqlite, false for cloud Supabase/PostgreSQL
NEXT_PUBLIC_USE_SQLITE=false

# Public Supabase credentials (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://jktoipmsdvcnljogitos.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_7PCJ9vSzaa8ZvH9hSYCkEg_ZH2PAi51
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7PCJ9vSzaa8ZvH9hSYCkEg_ZH2PAi51

# Supabase Service Role Key (Used for server administrative operations)
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL Pool connection string (Supabase Transaction/Session pooler)
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# App URL configuration
NEXT_PUBLIC_APP_URL=http://localhost:3002

